{
  "name": "entrega-fiable-eventos-pedidos",
  "version": "0.1.0",
  "private": true,
  "description": "Proyecto 03 de CHAMBA DIARIA: recepción y entrega fiable de eventos de pedidos.",
  "type": "module",
  "engines": {
    "node": ">=24.13.0 <25",
    "npm": ">=11.21.2 <12"
  },
  "packageManager": "npm@11.21.2",
  "scripts": {
    "typecheck": "tsc --project tsconfig.json --noEmit && tsc --project experiments/cola/tsconfig.json --noEmit && tsc --project tests/tsconfig.json --noEmit",
    "build": "tsc --project tsconfig.json && tsc --project experiments/cola/tsconfig.json && tsc --project tests/tsconfig.json",
    "test:queue": "node --env-file-if-exists=.env --test --test-concurrency=1 --test-timeout=180000 dist-experiment/queue.test.js",
    "db:experiment": "node scripts/database-experiment.mjs",
    "test:guards": "node --test dist-experiment/guards.test.js",
    "db:portable": "node scripts/database-portable.mjs",
    "test:core": "node --env-file-if-exists=.env --test --test-concurrency=1 --test-timeout=180000 dist-tests/tests/core/queue.test.js",
    "test:http": "node --env-file-if-exists=.env --test --test-concurrency=1 --test-timeout=180000 dist-tests/tests/http/http.test.js",
    "db:prepare": "node scripts/database-development.mjs prepare",
    "db:migrate": "node scripts/database-development.mjs migrate",
    "start": "node --env-file-if-exists=.env dist/server/main.js",
    "demo": "node --env-file-if-exists=.env scripts/demo.mjs",
    "test:delivery": "node --env-file-if-exists=.env --test --test-concurrency=1 --test-timeout=180000 dist-tests/tests/delivery/delivery.test.js",
    "db:delivery:prepare": "node scripts/database-delivery.mjs prepare",
    "db:delivery:migrate": "node scripts/database-delivery.mjs migrate",
    "worker": "node --env-file-if-exists=.env dist/worker/main.js",
    "receiver": "node --env-file-if-exists=.env dist/receiver/main.js",
    "receiver:inspect": "node --env-file-if-exists=.env scripts/inspect-receiver.mjs",
    "demo:delivery": "node --env-file-if-exists=.env scripts/demo-delivery.mjs",
    "test:operations": "node --env-file-if-exists=.env --test --test-concurrency=1 --test-timeout=180000 dist-tests/tests/operations/operations.test.js",
    "events:query": "node --env-file-if-exists=.env scripts/query-events.mjs",
    "db:query-tests": "node scripts/database-query-tests.mjs"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "pg-boss": "12.38.2",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "express": "5.3.0",
    "pg": "8.23.1"
  }
}
