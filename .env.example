# Plantilla sin secretos: no copiar sobre .env existente.
# db:portable up conserva/prepara la instancia exclusiva y TEST_DATABASE_URL.
TEST_DATABASE_URL=
# db:query-tests prepara p03_api_prueba: solo CONNECT, permisos por fixture.
TEST_API_DATABASE_URL=

# db:prepare crea base/roles nuevos de desarrollo y completa SOLO valores ausentes.
# Base de desarrollo: entrega_fiable_eventos_pedidos; rol API: p03_api.
DATABASE_URL=
# Solo db:migrate usa esta credencial; el servidor no ejecuta migraciones.
MIGRATION_DATABASE_URL=

# Bearer distintos, sin valores predeterminados; db:prepare genera 32 bytes aleatorios.
RECEPCION_TOKEN=
CONSULTA_TOKEN=

# Puerto HTTP opcional (por defecto 3003); escucha siempre en 127.0.0.1.
# PORT=3003

# db:delivery:prepare genera solo valores ausentes; no imprimir ni versionar.
WORKER_DATABASE_URL=
RECEPTOR_DATABASE_URL=
RECEPTOR_MIGRATION_DATABASE_URL=
ENTREGA_TOKEN=
DESTINO_URL=
# Receptor loopback; DESTINO_URL usa ese puerto y ruta /eventos.
# RECEPTOR_PORT=3004
